{
	"extends": "../../../packages/utils/tsconfig.base.json",
	"compilerOptions": {
		"composite": true,
		"rootDir": ".",
		"outDir": "./dist",
		"lib": ["ES2022", "DOM"],
		"types": ["node", "@types/bun", "vite/client"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": false,
		"noEmit": false,
		"declaration": true,
		"declarationMap": true,
		"jsx": "preserve",
		"jsxImportSource": "solid-js",
		"paths": {
			"@create-docs/*": ["./src/*"]
		}
	},
	"include": ["src/**/*", "test/**/*"],
	"exclude": ["node_modules", "dist", "*.config.ts", "**/examples/**"]
}
