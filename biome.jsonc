{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"a11y": {
				"noStaticElementInteractions": "off",
				"noNoninteractiveElementToInteractiveRole": "off",
				"useFocusableInteractive": "off",
				"useAnchorContent": "off"
			},
			"correctness": {
				"noNodejsModules": "off",
				"useHookAtTopLevel": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		},
		"domains": {
			"types": "recommended",
			"project": "recommended",
			"test": "recommended",
			"react": "recommended"
		}
	},
	"assist": {
		"enabled": true
	}
}
